FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      B;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -2 0 0 -1 0];

internalField   uniform (0 0.05 0);

boundaryField
{
    "(inlet|outlet|lowerWall|upperWall)"
    {
        type zeroGradient;
    }
   

    "(rightWall|leftWall)"
    {
        type fixedValue;
 	value uniform (0 0.05 0);
    }

}

